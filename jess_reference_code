function dstate = Cowells_full(t, state, ...
    muE, Re, J2, J3, J4, J5, J6, ...  
    Cd, Cr, area_km2, mass, omegaE, ...
    muSun, muMoon, P0, AU_km, jd0)
    
    % state = [r; v], r in km, v in km/s
    r = state(1:3);
    v = state(4:6);
    rmag = norm(r);
    x = r(1);
    y = r(2);
    z = r(3);
    
    % earth grav
    a_tb = -muE * r / rmag^3; %km/s2
    
    % atmos drag
    omegaVec = [0; 0; omegaE];        % rad/s
    v_rel = v - cross(omegaVec, r);   % km/s, velocity wrt rotating atmosphere
    alt   = rmag - Re;                % km
    rho   = ExponDensModData(alt) * 1e9; % kg/m3 to kg/km3
    
    a_drag = -0.5 * Cd * (area_km2/mass) * rho * norm(v_rel) * v_rel; % km/s2
    
    % zonal stuff
    % kJ2  = 1.5 * J2 * muE * Re^2 / rmag^5;
    % axJ2 = -kJ2 * x * (1 - 5*z^2/r2);
    % ayJ2 = -kJ2 * y * (1 - 5*z^2/r2);
    % azJ2 = -kJ2 * z * (3 - 5*z^2/r2);
    %
    % a_J  = [axJ2; ayJ2; azJ2];        % km/s2
    
    r2 = rmag^2;
    r4 = r2^2;
    r7 = rmag^7;
    r9 = rmag^9;
    r6 = r2^3;   % rmag^6
    
    % grav
    a_tb = -muE * r / rmag^3;   % km/s2
    
    % J2-J6
    
    % J2
    kJ2  = 1.5 * J2 * muE * Re^2 / rmag^5;
    aJ2x = -kJ2 * x * (1 - 5*z^2/r2);
    aJ2y = -kJ2 * y * (1 - 5*z^2/r2);
    aJ2z = -kJ2 * z * (3 - 5*z^2/r2);
    
    % J3
    aJ3x = ((-5*J3*muE*Re^2 * x)/(2*r7)) * ...
           ( 3*z - (7*z^3)/r2 );
    aJ3y = ((-5*J3*muE*Re^2 * y)/(2*r7)) * ...
           ( 3*z - (7*z^3)/r2 );
    aJ3z = ((-5*J3*muE*Re^2        )/(2*r7)) * ...
           ( 6*z^2 - (7*z^4)/r2 - (3*r2)/5 );
    
    % J4
    aJ4x = ((15*J4*muE*Re^4 * x)/(8*r7)) * ...
           ( 1 - (14*z^2)/r2 + (21*z^4)/r4 );
    aJ4y = ((15*J4*muE*Re^4 * y)/(8*r7)) * ...
           ( 1 - (14*z^2)/r2 + (21*z^4)/r4 );
    aJ4z = ((15*J4*muE*Re^4 * z)/(8*r7)) * ...
           ( 5 - (70*z^2)/r2 + (21*z^4)/r4 );
    
    % J5
    aJ5x = (3*J5*muE*Re^5*x*y / (8*r9)) .* ...
           ( 35 - (210*z^2)/r2 + (231*z^4)/r4 );
    
    aJ5y = (3*J5*muE*Re^5*y*z / (8*r9)) .* ...
           ( 35 - (210*z^2)/r2 + (231*z^4)/r4 );
    
    aJ5z = (3*J5*muE*Re^5*z^2 / (8*r9)) .* ...
           ( 105 - (315*z^2)/r2 + (231*z^4)/r4 ) ...
           - (15*J5*muE*Re^5) / (8*r7);
    
    % J6
    aJ6x = ((-J6*muE*Re^6 * x)/(16*r9)) * ...
           ( 35  - (945*z^2)/r2 + (3465*z^4)/r4 - (3003*z^6)/r6 );
    aJ6y = ((-J6*muE*Re^6 * y)/(16*r9)) * ...
           ( 35  - (945*z^2)/r2 + (3465*z^4)/r4 - (3003*z^6)/r6 );
    aJ6z = ((-J6*muE*Re^6 * z)/(16*r9)) * ...
           ( 245 - (2205*z^2)/r2 + (4851*z^4)/r4 - (3003*z^6)/r6 );
    
    % add zonals
    a_J = [aJ2x + aJ3x + aJ4x + aJ5x + aJ6x; ...
           aJ2y + aJ3y + aJ4y + aJ5y + aJ6y; ...
           aJ2z + aJ3z + aJ4z + aJ5z + aJ6z];
    
    
    % 3 body
    jd = jd0 + t/86400; % current Julian date
    
    % sun position in ECI (km)
    [~, ~, rSun] = solar_position(jd);
    rSun    = rSun(:);
    rSunMag = norm(rSun);
    
    % moon position in ECI (km)  
    rMoon = lunar_position(jd);
    rMoon = rMoon(:);
    rMoonMag = norm(rMoon);
    
    % Sun
    a_3b_sun  = muSun  * ( (rSun  - r)/norm(rSun  - r)^3 - rSun /rSunMag^3 );
    % Moon
    a_3b_moon = muMoon * ( (rMoon - r)/norm(rMoon - r)^3 - rMoon/rMoonMag^3 );
    
    % srp w eclipse
    area_m2 = area_km2 * 1e6; %km2 to m2
    
    % cylindrical shadow model (earth between sc and sun)
    theta  = acos( dot(rSun, r)/(rSunMag*rmag) );
    theta1 = acos( Re / rmag );
    theta2 = acos( Re / rSunMag );
    
    if theta1 + theta2 < theta
        F_eclipse = 0; % in umbra
    else
        F_eclipse = 1; % illuminated
    end
    
    % SRP pressure at current Sun distance (N/m2)
    P = P0 * (AU_km / rSunMag)^2;
    
    % Acceleration due to SRP. UNITS
    a_srp = F_eclipse * (P * Cr * area_m2 / mass) / 1000 * (-rSun/rSunMag); % km/s2
    
    % TOTAL ACCEL.
    a_total = a_tb + a_drag + a_J + a_3b_sun + a_3b_moon + a_srp;
    
    dstate  = [v; a_total];
end
